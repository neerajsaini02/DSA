//Arrange the Numbers

#include<iostream>
using namespace std;

int main(){
    int t;
    cin>>t;

    for(int j=0;j<t;j++){

        int n;
        cin>>n;

        int arr[n];

        for(int i=0;i<n;i++){
            cin>>arr[i];
        }

        int i=0;
        while(i>n-i-1){
           arr[i]=i+1;
           arr[n-i-1]=i+2;
           i++;
        }
        if(n%2!=0){
            arr[i]=i+1;
        }

         for(int i=0;i<n;i++){
            cout<<arr[i]<<" ";
        }

    }
}